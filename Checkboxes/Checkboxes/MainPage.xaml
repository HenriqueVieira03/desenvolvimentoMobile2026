<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Checkboxes.MainPage">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="15">

        <Label Grid.Row="0"
               Text="Minhas Tarefas" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="TxtNovaTarefa" 
                   Grid.Column="0" 
                   Placeholder="Digite uma nova tarefa..." 
                   ClearButtonVisibility="WhileEditing" />

            <Button Grid.Column="1" 
                    Text="Adicionar" 
                    Clicked="OnAdicionarClicked" />
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="ListaTarefas" Spacing="10" />
        </ScrollView>

        <Label x:Name="LblContador"
               Grid.Row="3"
               Text="0 de 0 tarefas concluídas" 
               FontSize="14" 
               HorizontalOptions="Center" />
    </Grid>

</ContentPage>