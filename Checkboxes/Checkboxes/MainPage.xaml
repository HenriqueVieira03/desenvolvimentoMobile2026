<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Checkboxes.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0,0,0" Spacing="15">
            <Image Source="musicstore.png"/>

            <Label Text="Selecione os álbuns desejados:"/>

            <Grid BackgroundColor="AntiqueWhite">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>                    
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Source="darkside.png"/>
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="chk1" 
                          CheckedChanged="Checkbox_CheckedChanged"/>
                <Label Grid.Row="0" Grid.Column="2" x:Name="val1"
                       VerticalTextAlignment="Center" Text="89.55"/>

                <Image Grid.Row="1" Grid.Column="0" Source="divisionbell.png"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chk2" 
                       CheckedChanged="Checkbox_CheckedChanged"/>
                <Label Grid.Row="1" Grid.Column="2" x:Name="val2"
                        VerticalTextAlignment="Center" Text="75.30"/>

                <Image Grid.Row="2" Grid.Column="0" Source="wall.png"/>
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chk3" 
                        CheckedChanged="Checkbox_CheckedChanged"/>
                <Label Grid.Row="2" Grid.Column="2" x:Name="val3"
                        VerticalTextAlignment="Center" Text="150.45"/>
            </Grid>

            <HorizontalStackLayout Spacing="10" 
                                   BackgroundColor="AntiqueWhite">
                <Label Text="R$ " FontSize="50"/>
                <Label x:Name="lbTotal" FontSize="50" 
                       FontAttributes="Bold"
                       TextColor="Red"
                       Text="0,00"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
