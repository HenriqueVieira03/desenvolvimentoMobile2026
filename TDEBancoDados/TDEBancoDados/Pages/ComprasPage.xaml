<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TDEBancoDados.Models"
             x:Class="TDEBancoDados.Pages.ComprasPage"
             Title="Compra">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16" RowSpacing="12">

        <Border Grid.Row="0" Style="{StaticResource Cartao}">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="LblModo" Text="Nova compra" Style="{StaticResource TituloSecao}" />
                <Picker x:Name="PckCliente" Title="Cliente" />
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Label Text="Data da compra" VerticalOptions="Center" />
                    <DatePicker Grid.Column="1" x:Name="DtCompra" Format="dd/MM/yyyy" />
                </Grid>
                <Label x:Name="LblTotal" Text="Valor total: R$ 0,00 (calculado pelos itens)" Style="{StaticResource TextoSecundario}" />
                <Button x:Name="BtnItens" Text="Itens da compra" IsEnabled="False"
                        Style="{StaticResource BotaoSecundario}" Clicked="OnItensClicked" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Salvar" Clicked="OnSalvarClicked" />
            <Button Grid.Column="1" Text="Nova" Style="{StaticResource BotaoSecundario}" Clicked="OnNovaClicked" />
            <Button Grid.Column="2" x:Name="BtnExcluir" Text="Excluir" Style="{StaticResource BotaoPerigo}"
                    IsEnabled="False" Clicked="OnExcluirClicked" />
        </Grid>

        <Label Grid.Row="2" Text="Compras registradas (toque para editar)" Style="{StaticResource TextoSecundario}" />

        <CollectionView Grid.Row="3"
                        x:Name="ListaCompras"
                        SelectionMode="Single"
                        SelectionChanged="OnCompraSelecionada"
                        EmptyView="Nenhuma compra registrada.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Compra">
                    <Border Style="{StaticResource ItemLista}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Detalhes}" Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
